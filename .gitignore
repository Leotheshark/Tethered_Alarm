# Python 自動生成的編譯檔（必加！）
__pycache__/
*.pyc
*.pyo
*.pyd

# 虛擬環境資料夾（必加！）
.venv/
venv/
ENV/

# 編輯器與 IDE 設定（避免互相覆蓋個人習慣）
.vscode/
.cursor/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 作業系統產生的垃圾檔案
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# 隨機生成的日誌或測試檔案
*.log

# 機密資訊與 API 金鑰（絕對不能上傳）
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
credentials.*

# Claude Code 本機設定（含個人 hook、金鑰等）
settings*.json
.claude/.credentials.json
CLAUDE.md

# PyInstaller 打包產物（由 pyinstaller.spec 重新產生，不入版控）
build/
dist/
*.manifest
# 打包 / 冒煙測試暫存輸出
build_log.txt
smoke_test.txt
gc_test*.txt
game_client_test*.txt
